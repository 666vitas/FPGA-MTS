////////////////////////////////////////////////////////////////////////////////
// Laser lock core - v1_pd_passthrough
//
// This first board-test version only verifies the FPGA data path:
//   Red Pitaya IN1 -> adc_dat[0] -> laser_lock_core -> DAC A / OUT1
//
// No MTS demodulation, filtering, mixing, PID, sweep, or AI is implemented here.
////////////////////////////////////////////////////////////////////////////////

module laser_lock_core (
    input  logic               clk_i,
    input  logic               rstn_i,
    input  logic signed [13:0] pd_i,
    input  logic signed [13:0] ref_i,
    output logic signed [13:0] error_o,
    output logic signed [13:0] control_o
);

    // v1 passthrough:
    // - error_o follows the PD input.
    // - control_o is held at zero.
    // - ref_i is reserved for later MTS reference processing.
    always_ff @(posedge clk_i) begin
        if (!rstn_i) begin
            error_o   <= 14'sd0;
            control_o <= 14'sd0;
        end else begin
            error_o   <= pd_i;
            control_o <= 14'sd0;
        end
    end

endmodule: laser_lock_core
