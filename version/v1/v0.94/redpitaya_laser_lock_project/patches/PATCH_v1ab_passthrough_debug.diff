diff --git a/rtl/red_pitaya_top.sv b/rtl/red_pitaya_top.sv
index 0000000..0000000 100644
--- a/rtl/red_pitaya_top.sv
+++ b/rtl/red_pitaya_top.sv
@@ -133,6 +133,12 @@ inout  logic [ 8-1:0] led_o
 
 localparam int unsigned GDW = DWE;
 
+// Laser lock debug integration switch.
+// USE_LASER_LOCK_CORE = 0 keeps the official ASG + PID DAC path.
+// LASER_LOCK_OUTPUT_MODE: 0 = IN1/pd_i -> OUT1, 1 = IN2/ref_i -> OUT1.
+localparam logic USE_LASER_LOCK_CORE = 1'b1;
+localparam int   LASER_LOCK_OUTPUT_MODE = 0;
+
 logic [4-1:0] fclk ; //[0]-125MHz, [1]-250MHz, [2]-50MHz, [3]-200MHz
 logic [4-1:0] frstn;
 
@@ -195,6 +201,10 @@ logic        [14-1:0] dac_dat_a, dac_dat_b;
 logic        [14-1:0] dac_a    , dac_b    ;
 logic signed [15-1:0] dac_a_sum, dac_b_sum;
 
+// Custom laser lock core outputs, still before the official DAC saturation path.
+logic signed [14-1:0] laser_error;
+logic signed [14-1:0] laser_control;
+
 // ASG
 SBG_T [2-1:0]            asg_dat;
 
@@ -405,13 +415,33 @@ always @(posedge adc_clk) begin
   adc_dat[1] <= digital_loop ? dac_b : {adc_dat_raw[1][14-1], ~adc_dat_raw[1][14-2:0]};
 end
 
+////////////////////////////////////////////////////////////////////////////////
+// Custom laser lock core: v1ab_passthrough_debug
+////////////////////////////////////////////////////////////////////////////////
+
+laser_lock_core #(
+  .OUTPUT_MODE(LASER_LOCK_OUTPUT_MODE)
+) i_laser_lock_core (
+  .clk_i     (adc_clk      ),
+  .rstn_i    (adc_rstn     ),
+  .pd_i      (adc_dat[0]   ),
+  .ref_i     (adc_dat[1]   ),
+  .error_o   (laser_error  ),
+  .control_o (laser_control)
+);
+
 ////////////////////////////////////////////////////////////////////////////////
 // DAC IO
 ////////////////////////////////////////////////////////////////////////////////
 
 // Sumation of ASG and PID signal perform saturation before sending to DAC 
-assign dac_a_sum = asg_dat[0] + pid_dat[0];
-assign dac_b_sum = asg_dat[1] + pid_dat[1];
+assign dac_a_sum = USE_LASER_LOCK_CORE
+                 ? {laser_error[14-1], laser_error}
+                 : asg_dat[0] + pid_dat[0];
+
+assign dac_b_sum = USE_LASER_LOCK_CORE
+                 ? 15'sd0
+                 : asg_dat[1] + pid_dat[1];
 
 // saturation
 assign dac_a = (^dac_a_sum[15-1:15-2]) ? {dac_a_sum[15-1], {13{~dac_a_sum[15-1]}}} : dac_a_sum[14-1:0];
